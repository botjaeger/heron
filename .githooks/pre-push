#!/bin/zsh
# Pre-push: the full gate (scripts/check.sh: format lint, SwiftLint, debug and release builds with
# 0 warnings, swift test, heron-snap). Activate with scripts/install-hooks.sh.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
scripts/check.sh || { print -u2 -- "\npre-push: scripts/check.sh failed; nothing was pushed."; exit 1; }
